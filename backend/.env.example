# ──────────────────────────────────────────────────────────────
# AdaptRoute-Edu Backend Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────
APP_NAME="AdaptRoute-Edu"
APP_VERSION="1.0.0"
ENVIRONMENT=development           # development | production
DEBUG=true

# ── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://adaptroute:adaptroute_secret@localhost:5432/adaptroute_edu
POSTGRES_USER=adaptroute
POSTGRES_PASSWORD=adaptroute_secret
POSTGRES_DB=adaptroute_edu

# ── JWT Authentication ─────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Provider ───────────────────────────────────────────────
# Options: ollama | huggingface
LLM_PROVIDER=ollama
LLM_MODEL=gemma3

# Ollama settings (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace settings (when LLM_PROVIDER=huggingface)
HUGGINGFACE_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_TOKEN=hf_YOUR_TOKEN_HERE

# ── LLM Generation Settings ────────────────────────────────────
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=120

# ── CORS ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                   # json | text
